{
  "name": "whatsapp-linker",
  "version": "1.0.0",
  "description": "WhatsApp linking app using WhatsApp Web",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "simple-server": "ts-node src/simple-server.ts",
    "simple-server:dev": "ts-node --watch src/simple-server.ts",
    "test-simple": "ts-node test-simple-linker.ts",
    "install-browsers": "npx playwright install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "playwright": "^1.40.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0"
  }
}
